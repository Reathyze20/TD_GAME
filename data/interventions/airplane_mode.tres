[ext_resource type="Script" path="res://scripts/resources/intervention_data.gd" id="1_arpln"]

[resource]
script = ExtResource("1_arpln")
id = &"airplane_mode"
name = "Airplane Mode"
short = "Airplane"
description = "Cut the signal. Every distraction on the field stops moving for 3s. Costs 3 Rush — you only get it by letting them get close."
type = "freeze_field"
