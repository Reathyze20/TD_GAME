[gd_resource type="Resource" script_class="CardData" format=3]

[ext_resource type="Script" path="res://scripts/resources/card_effect_data.gd" id="1_eff"]
[ext_resource type="Script" path="res://scripts/resources/card_data.gd" id="2_card"]

[sub_resource type="Resource" id="Resource_tb1"]
script = ExtResource("1_eff")
stat_type = "fire_cooldown"
target = "focus_timer"
value = -0.25

[sub_resource type="Resource" id="Resource_tb2"]
script = ExtResource("1_eff")
stat_type = "range"
target = "focus_timer"
value = 0.15

[resource]
script = ExtResource("2_card")
id = &"time_blocking"
title = "Time Blocking"
description = "A slot on the calendar is a decision you already made — so you don't have to make it again while tired."
rarity = &"rare"
effects = Array[ExtResource("1_eff")]([SubResource("Resource_tb1"), SubResource("Resource_tb2")])
