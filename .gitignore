# Godot 4+ specific ignores
.godot/
/android/

# Assistant workspace (session-local, not project content)
.claude/

# Pre-write backups (map editor levels, art atlases) — git IS the history now
*.bak
*.bak[0-9]

# Python bytecode from the tools/ art pipeline
__pycache__/
*.pyc

# Temporary headless test harnesses (always deleted after a run, but just in case)
/_test_*

# verify.sh per-test logs. Excludes CONTENTS (not the directory itself, /.dev/*
# rather than /.dev/) so the screenshots/ carve-out below can actually work — git
# cannot re-include a path whose PARENT DIRECTORY was excluded, only individual
# excluded entries within a still-tracked-as-a-directory parent.
/.dev/*
# T7 (docs/refactor/MIGRATION.MD) explicitly wants its readability screenshot set
# committed from inside .dev/ — carved out rather than moving the whole task's
# output path, since the task's own text names this exact directory.
!/.dev/screenshots/

# Náhledy a mezivýsledky nástrojů (sprite_cleanup) — do hry se kopíruje přes --apply
/build/

# Váhy modelů pro tools/gen.py — ~10 GB, stahuje se, do gitu nikdy nepatří
/models/
.gstack/

# PixelLab API token — NIKDY do gitu
.pixellab_token
